            "source": [
                "### Temporal Attention Patterns\n",
                "\n",
                "- Early/Mid/Late attention distributions.\n",
                "- Attention entropy; self vs context (diagonal/off-diagonal).\n"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "5bb28490",
            "metadata": {},
            "outputs": [
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "2026-06-15 08:05:30,640  INFO      \n",
                        "2. Analizando importancia temporal de posiciones...\n",
                        "C:\\Users\\alanz\\AppData\\Local\\Temp\\ipykernel_24680\\1104747586.py:52: RuntimeWarning: divide by zero encountered in log\n",
                        "  entropy = -np.sum(row_norm * np.log(row_norm + 1e-12))\n",
                        "C:\\Users\\alanz\\AppData\\Local\\Temp\\ipykernel_24680\\1104747586.py:52: RuntimeWarning: invalid value encountered in multiply\n",
                        "  entropy = -np.sum(row_norm * np.log(row_norm + 1e-12))\n",
                        "C:\\Users\\alanz\\AppData\\Local\\Temp\\ipykernel_24680\\1104747586.py:80: MatplotlibDeprecationWarning: The 'labels' parameter of boxplot() has been renamed 'tick_labels' since Matplotlib 3.9; support for the old name will be dropped in 3.11.\n",
                        "  bp = ax1.boxplot(\n"
