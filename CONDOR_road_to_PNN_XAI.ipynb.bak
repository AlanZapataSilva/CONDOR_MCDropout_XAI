            "source": [
                "# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "# Â§0.1.16  Test Evaluation â€” Bayesian Classifier\n",
                "# Â· model.evaluate  â†’ mÃ©tricas Keras (1 pase, MCDropout activo â†’ valor ruidoso\n",
                "#                     pero comparable con curvas de entrenamiento)\n",
                "# Â· mc_predict      â†’ inferencia probabilÃ­stica (T pases)\n",
                "# Â· Temperature Scaling â†’ calibraciÃ³n post-hoc sobre val set\n",
                "# Â· MÃ©tricas bayesianas â†’ ECE, Brier, NLL, AUROC errores\n",
                "# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "\n",
                "# â”€â”€ 1. Keras evaluate (reemplaza bloque original de 3 outputs) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "eval_results = model.evaluate(\n",
                "    x=[X_test, Xg_test],\n",
                "    y=y_label_test,  # â† solo clasificaciÃ³n, sin Ã¡ngulo ni energÃ­a\n",
                "    verbose=1,\n",
                ")\n",
                "metrics_names = model.metrics_names\n",
                "eval_dict = {name: float(val) for name, val in zip(metrics_names, eval_results)}\n",
                "logging.info(\"Keras evaluate â€” %s\", eval_dict)\n",
                "# NOTA: la pÃ©rdida y accuracy variarÃ¡n ligeramente en cada ejecuciÃ³n porque\n",
                "# MCDropout permanece activo. Usar mc_predict para mÃ©tricas finales reportadas.\n",
                "\n",
                "# â”€â”€ 2. MC Dropout inference â€” val set (nuevo, necesario para Temperature Scaling) â”€â”€\n",
                "logging.info(\"MC Dropout inference â€” val set (T=%d)...\", MC_T)\n",
                "mc_val = mc_predict(model, X_val, Xg_val, T=MC_T, batch_size=MC_BATCH)\n",
                "\n",
                "# â”€â”€ 3. Temperature Scaling (nuevo) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "T_opt, nll_val_min = find_optimal_temperature(mc_val[\"p_hat\"], y_label_val)\n",
                "logging.info(\"Temperature Scaling â€” T* = %.4f  |  NLL_val = %.4f\", T_opt, nll_val_min)\n",
                "\n",
                "# â”€â”€ 4. MC Dropout inference â€” test set (reemplaza model.predict) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "logging.info(\"MC Dropout inference â€” test set (T=%d)...\", MC_T)\n",
                "mc_test = mc_predict(model, X_test, Xg_test, T=MC_T, batch_size=MC_BATCH)\n",
                "\n",
                "p_hat = mc_test[\"p_hat\"]  # pÌ‚_Î³     â€” reemplaza pred_particle\n",
                "sigma2_ep = mc_test[\"sigma2_ep\"]  # ÏƒÂ²_ep\n",
                "H = mc_test[\"H\"]  # H[y|x]\n",
                "MI = mc_test[\"MI\"]  # MI[y,Ï‰|x]\n",
                "all_preds = mc_test[\"all_preds\"]  # (T, N)\n",
                "\n",
                "p_hat_cal = temperature_scale(p_hat, T_opt)  # probabilidades calibradas\n",
                "pred_particle_labels = (p_hat_cal >= 0.5).astype(np.int32)\n",
                "particle_accuracy = float(np.mean(pred_particle_labels == y_label_test))\n",
                "\n",
                "# â”€â”€ 5. pred_summary (reemplaza original â€” sin columnas de Ã¡ngulo ni energÃ­a) â”€â”€\n",
                "pred_summary = pd.DataFrame(\n",
                "    {\n",
                "        \"particle_true\": y_label_test.astype(int),\n",
                "        \"p_hat\": p_hat,  # predicciÃ³n MC (sin calibrar)\n",
                "        \"p_hat_cal\": p_hat_cal,  # predicciÃ³n calibrada\n",
                "        \"particle_pred_label\": pred_particle_labels,\n",
                "        \"sigma2_ep\": sigma2_ep,\n",
                "        \"H\": H,\n",
                "        \"MI\": MI,\n",
                "        # Covariables fÃ­sicas â€” NO son predicciones, se usan para anÃ¡lisis estratificado\n",
                "        \"energy_level_true\": y_energy_test,\n",
                "        \"angle_true_deg\": y_angle_test.astype(float),\n",
                "    }\n",
                ")\n",
                "pred_summary[\"particle_correct\"] = (\n",
                "    pred_summary[\"particle_pred_label\"] == pred_summary[\"particle_true\"]\n",
                ")\n",
                "\n",
                "# â”€â”€ 6. MÃ©tricas bayesianas (nuevas) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "\n",
                "# â€” 6a. CalibraciÃ³n â€”\n",
                "ece_uncal = compute_ece(p_hat, y_label_test)\n",
                "ece_cal = compute_ece(p_hat_cal, y_label_test)\n",
                "\n",
                "brier_uncal = compute_brier_score(p_hat, y_label_test)\n",
                "brier_cal = compute_brier_score(p_hat_cal, y_label_test)\n",
                "\n",
                "nll_uncal = float(\n",
                "    -np.mean(\n",
                "        y_label_test * np.log(p_hat + 1e-8)\n",
                "        + (1 - y_label_test) * np.log(1 - p_hat + 1e-8)\n",
                "    )\n",
                ")\n",
                "nll_cal = float(\n",
                "    -np.mean(\n",
                "        y_label_test * np.log(p_hat_cal + 1e-8)\n",
                "        + (1 - y_label_test) * np.log(1 - p_hat_cal + 1e-8)\n",
                "    )\n",
                ")\n",
                "\n",
                "calibration_summary = pd.DataFrame(\n",
                "    {\n",
                "        \"MÃ©trica\": [\"ECE\", \"NLL\", \"Brier Score\", \"AUC (invariante)\"],\n",
                "        \"Sin calibrar\": [\n",
                "            ece_uncal,\n",
                "            nll_uncal,\n",
                "            brier_uncal[\"brier\"],\n",
                "            roc_auc_score(y_label_test, p_hat),\n",
                "        ],\n",
                "        \"Calibrado\": [\n",
                "            ece_cal,\n",
                "            nll_cal,\n",
                "            brier_cal[\"brier\"],\n",
                "            roc_auc_score(y_label_test, p_hat_cal),\n",
                "        ],\n",
                "    }\n",
                ")\n",
                "display(calibration_summary.round(4))\n",
                "\n",
                "# â€” 6b. DiscriminaciÃ³n clÃ¡sica (sobre predicciÃ³n calibrada) â€”\n",
                "fpr, tpr, _ = roc_curve(y_label_test, p_hat_cal)\n",
                "roc_auc = auc(fpr, tpr)\n",
                "gh_metrics = gamma_hadron_metrics(y_label_test, p_hat_cal, threshold=0.5)\n",
                "\n",
                "particle_report = classification_report(\n",
                "    y_label_test,\n",
                "    pred_particle_labels,\n",
                "    target_names=[\"Proton\", \"Photon\"],\n",
                "    output_dict=True,\n",
                ")\n",
                "display(pd.DataFrame(particle_report).T.round(4))\n",
                "\n",
                "# â€” 6c. AUROC de errores (nueva â€” valida que ÏƒÂ²_ep predice errores) â€”\n",
                "error_auroc = compute_error_auroc(p_hat_cal, y_label_test, sigma2_ep)\n",
                "logging.info(\n",
                "    \"AUROC de detecciÃ³n de errores: %.4f  (umbral bayesiano: >0.70)\",\n",
                "    error_auroc,\n",
                ")\n",
                "\n",
                "additional_metrics = {\n",
                "    \"particle_accuracy_custom\": particle_accuracy,\n",
                "    \"ece_uncal\": ece_uncal,\n",
                "    \"ece_cal\": ece_cal,\n",
                "    \"brier_uncal\": brier_uncal[\"brier\"],\n",
                "    \"brier_cal\": brier_cal[\"brier\"],\n",
                "    \"nll_uncal\": nll_uncal,\n",
                "    \"nll_cal\": nll_cal,\n",
                "    \"error_auroc\": error_auroc,\n",
                "    \"T_opt\": T_opt,\n",
                "}\n"
            ]
        },
        {
