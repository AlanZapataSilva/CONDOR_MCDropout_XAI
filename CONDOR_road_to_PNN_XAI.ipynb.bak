    "with metadata_path.open(\"w\", encoding=\"utf-8\") as fh:\n",
    "    json.dump(metadata, fh, indent=2)\n",
    "\n",
    "# ── 8. MLflow (reemplaza bloque original — métricas actualizadas) ─────────────\n",
    "mlflow.log_params({\"temperature_T_opt\": round(T_opt, 4), \"MC_T\": MC_T})\n",
    "\n",
    "mlflow.log_metrics(\n",
    "    {\n",
    "        # Discriminación\n",
    "        \"auc\": roc_auc,\n",
    "        \"q_factor\": gh_metrics[\"q_factor\"],\n",
    "        \"gamma_efficiency\": gh_metrics[\"efficiency_gamma\"],\n",
    "        \"hadron_contamination\": gh_metrics[\"contamination_hadron\"],\n",
    "        \"f1_score\": eval_dict.get(\"f1_score\", float(\"nan\")),\n",
