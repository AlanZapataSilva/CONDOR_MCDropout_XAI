                "        _seq_sv = np.asarray(sv[0], dtype=np.float32)\n",
                "        _glob_sv = np.asarray(sv[1], dtype=np.float32)\n",
                "    shap_seq_runs.append(_seq_sv)\n",
                "    shap_global_runs.append(_glob_sv)\n",
