      "2026-06-08 01:53:41,673  INFO      \n",
      " ANGULAR RESOLUTION (Standard Metrics)\n",
      "============================================================\n",
      "  bias_deg            : 0.0245\n",
      "  median_error_deg    : 0.6197\n",
      "  rms_deg             : 1.2733\n",
      "  psf_68_deg          : 0.9970\n",
