            ],
            "source": [
                "#\n",
                "# PAPER EXTRACTION CELL v2.3 hot/cold kernel aware\n",
                "# Funciona con kernel activo O despuÃ©s de reinicio\n",
                "#\n",
                "\n",
                "# â”€â”€ BLOQUE DE CONFIGURACIÃ“N W5 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "W5_VARS = {\n",
                "    \"shap_seq_summary\": \"shap_seq_summary\",\n",
                "    \"shap_global_summary\": \"shap_global_summary\",\n",
                "    \"phi_0\": \"phi0\",\n",
                "    \"additivity_error\": \"additivity_error\",\n",
                "    \"N_BG\": \"N_BG\",\n",
                "    \"N_SAMPLE\": \"N_SAMPLE\",\n",
                "    \"T_SHAP\": \"T_SHAP\",\n",
                "    \"SHAP_SEED\": \"SEED\",\n",
                "    \"GLOBAL_FEATURE_NAMES\": \"GLOBAL_FEATURE_NAMES\",\n",
                "}\n",
                "# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "\n",
                "import json\n",
                "import numpy as np\n",
                "import pandas as pd\n",
                "from pathlib import Path\n",
                "\n",
                "BASE_DIR = Path.cwd()\n",
                "ARTIFACTS_DIR = BASE_DIR / \"pipeline_artifacts\"\n",
                "W5_PERSIST = ARTIFACTS_DIR / \"w5_persist\"\n",
                "\n",
                "\n",
                "# â”€â”€ Helper â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "def _f(v) -> \"float | None\":\n",
                "    try:\n",
                "        v = float(v)\n",
                "        return None if (np.isnan(v) or np.isinf(v)) else v\n",
                "    except Exception:\n",
                "        return None\n",
                "\n",
                "\n",
                "def _top_n_records(df, sort_col, n=3, str_cols=(\"feature\",)):\n",
                "    rows = df.nlargest(n, sort_col).to_dict(\"records\")\n",
                "    return [\n",
                "        {k: (str(v) if k in str_cols else _f(v)) for k, v in row.items()}\n",
                "        for row in rows\n",
                "    ]\n",
                "\n",
                "\n",
                "# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•\n",
                "# MODO AUTOMÃTICO: detecta si el kernel estÃ¡ caliente o frÃ­o\n",
                "# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•\n",
                "_ns = set(globals().keys())\n",
                "_kernel_hot = all(v in _ns for v in [\"model\", \"p_hat\", \"ablation_results\"])\n",
                "\n",
                "print(\n",
                "    f\"Modo kernel: {'ðŸ”¥ CALIENTE (variables en RAM)' if _kernel_hot else 'â„ï¸  FRÃO (reconstruyendo desde disco)'}\\n\"\n",
                ")\n",
                "\n",
                "if _kernel_hot:\n",
                "    # â”€â”€ MODO CALIENTE: leer desde RAM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    print(\"Leyendo variables desde RAM...\")\n",
                "\n",
                "    def _get(alias):\n",
                "        real = W5_VARS[alias]\n",
                "        if real not in globals():\n",
                "            raise NameError(f\"Variable '{real}' (alias '{alias}') no en RAM.\")\n",
                "        return globals()[real]\n",
                "\n",
                "    _model_params = int(model.count_params())\n",
                "    _history = history.history\n",
                "    _X_train = X_train\n",
                "    _X_val = X_val\n",
                "    _X_test = X_test\n",
                "    _Xg_train = Xg_train\n",
                "    _y_label_test = y_label_test\n",
                "    _p_hat = p_hat\n",
                "    _p_hat_cal = p_hat_cal\n",
                "    _sigma2_ep = sigma2_ep\n",
                "    _T_opt = T_opt\n",
                "    _nll_val_min = nll_val_min\n",
                "    _ece_uncal = ece_uncal\n",
                "    _ece_cal = ece_cal\n",
                "    _brier_uncal = brier_uncal\n",
                "    _brier_cal = brier_cal\n",
                "    _nll_uncal = nll_uncal\n",
                "    _nll_cal = nll_cal\n",
                "    _error_auroc = error_auroc\n",
                "    _roc_auc = roc_auc\n",
                "    _particle_acc = particle_accuracy\n",
                "    _gh_metrics = gh_metrics\n",
                "    _pred_summary = pred_summary\n",
                "    _acc_90 = acc_at_90_coverage\n",
                "    _delta_acc = delta_acc_rejection\n",
                "    _ablation = ablation_results\n",
                "    _baseline_scores = baseline_scores\n",
                "    _pfi = pfi_results\n",
                "    _ablation_strat = str(ABLATION_STRATEGY_USED)\n",
                "    _feat_names = list(FEATURE_NAMES)\n",
                "    _max_seq_len = int(max_sequence_length)\n",
                "    _energy_filter = list(ENERGY_FILTER)\n",
                "    _angle_max = float(ANGLE_MAX)\n",
                "    _min_particles = int(MIN_TOTAL_PARTICLES)\n",
                "    _batch_size = int(BATCH_SIZE)\n",
                "    _epochs = int(EPOCHS)\n",
                "    _mc_t = int(MC_T)\n",
                "    _mc_batch = int(MC_BATCH)\n",
                "    _seed = int(SEED)\n",
                "\n",
                "    _shap_seq_sum = _get(\"shap_seq_summary\")\n",
                "    _shap_glob_sum = _get(\"shap_global_summary\")\n",
                "    _phi_0 = _f(_get(\"phi_0\"))\n",
                "    _add_error = _get(\"additivity_error\")\n",
                "    _n_bg = int(_get(\"N_BG\"))\n",
                "    _n_sample = int(_get(\"N_SAMPLE\"))\n",
                "    _t_shap = int(_get(\"T_SHAP\"))\n",
                "    _shap_seed = int(_get(\"SHAP_SEED\"))\n",
                "    _global_feat = list(_get(\"GLOBAL_FEATURE_NAMES\"))\n",
                "\n",
                "else:\n",
                "    # â”€â”€ MODO FRÃO: reconstruir desde disco â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    print(\"Reconstruyendo desde disco...\")\n",
                "\n",
                "    # Rutas de archivos esperados\n",
                "    _files = {\n",
                "        \"metrics\": ARTIFACTS_DIR / \"model\" / \"evaluation_metrics.json\",\n",
                "        \"predictions\": ARTIFACTS_DIR / \"test_predictions.npz\",\n",
                "        \"metadata\": ARTIFACTS_DIR / \"preprocessing_metadata.json\",\n",
                "        \"history_csv\": ARTIFACTS_DIR / \"model\" / \"training_history.csv\",\n",
                "        \"pred_summary\": ARTIFACTS_DIR / \"diagnostics\" / \"pred_summary.csv\"\n",
                "        if (ARTIFACTS_DIR / \"diagnostics\" / \"pred_summary.csv\").exists()\n",
                "        else None,\n",
                "        \"ablation\": ARTIFACTS_DIR / \"diagnostics\" / \"feature_ablation_results.csv\",\n",
                "        \"ablation_sum\": ARTIFACTS_DIR / \"diagnostics\" / \"feature_ablation_summary.csv\",\n",
                "        \"pfi\": ARTIFACTS_DIR / \"diagnostics\" / \"pfi_all_heads_sequence_only.csv\",\n",
                "        \"perf_summary\": ARTIFACTS_DIR / \"performance_summary.csv\",\n",
                "        \"w5_scalars\": W5_PERSIST / \"w5_scalars.json\",\n",
                "        \"w5_shap_seq\": W5_PERSIST / \"shap_seq_summary.csv\",\n",
                "        \"w5_shap_glob\": W5_PERSIST / \"shap_global_summary.csv\",\n",
                "        \"w5_add_df\": W5_PERSIST / \"additivity_df.csv\",\n",
                "        \"shap_arrays\": ARTIFACTS_DIR / \"diagnostics\" / \"shap_sequence_arrays.npz\",\n",
                "    }\n",
                "\n",
                "    missing_files = [k for k, p in _files.items() if p and not Path(p).exists()]\n",
                "    if missing_files:\n",
                "        raise FileNotFoundError(\n",
                "            f\"Archivos faltantes en disco: {missing_files}\\n\"\n",
                "            f\"  Verifica que el pipeline ejecutÃ³ completamente y \"\n",
                "            f\"que la celda de persistencia W5 fue incluida.\"\n",
                "        )\n",
                "\n",
                "    # â”€â”€ Cargar mÃ©tricas y metadata â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    with open(_files[\"metrics\"]) as fh:\n",
                "        _metrics_json = json.load(fh)\n",
                "    with open(_files[\"metadata\"]) as fh:\n",
                "        _meta = json.load(fh)\n",
                "    with open(_files[\"w5_scalars\"]) as fh:\n",
                "        _w5_sc = json.load(fh)\n",
                "\n",
                "    # â”€â”€ Cargar predicciones NPZ â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    _npz = np.load(_files[\"predictions\"], allow_pickle=True)\n",
                "    _p_hat = _npz[\"p_hat\"]\n",
                "    _p_hat_cal = _npz[\"p_hat_cal\"]\n",
                "    _sigma2_ep = _npz[\"sigma2_ep\"]\n",
                "    _y_label_test = _npz[\"particle_label_true\"]\n",
                "\n",
                "    # â”€â”€ Cargar historial de entrenamiento â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    _hist_df = pd.read_csv(_files[\"history_csv\"])\n",
                "    _history = {col: _hist_df[col].tolist() for col in _hist_df.columns}\n",
                "\n",
                "    # â”€â”€ Cargar pred_summary desde NPZ si no hay CSV â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    _pred_summary = pd.DataFrame(\n",
                "        {\n",
                "            \"particle_true\": _npz[\"particle_label_true\"],\n",
                "            \"p_hat_cal\": _npz[\"p_hat_cal\"],\n",
                "            \"particle_pred_label\": (_npz[\"p_hat_cal\"] >= 0.5).astype(int),\n",
                "            \"sigma2_ep\": _npz[\"sigma2_ep\"],\n",
                "            \"energy_level_true\": _npz[\"energy_level_true\"],\n",
                "        }\n",
                "    )\n",
                "    _pred_summary[\"particle_correct\"] = (\n",
                "        _pred_summary[\"particle_pred_label\"] == _pred_summary[\"particle_true\"]\n",
                "    )\n",
                "\n",
                "    # â”€â”€ Cargar ablation y PFI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    _ablation = pd.read_csv(_files[\"ablation\"])\n",
                "    _pfi = pd.read_csv(_files[\"pfi\"])\n",
                "    _ablation_strat = _meta.get(\"ablation_config\", {}).get(\"strategy_used\", \"median\")\n",
                "\n",
                "    _perf = pd.read_csv(_files[\"perf_summary\"])\n",
                "\n",
                "    def _perf_val(metric_name):\n",
                "        row = _perf[_perf[\"Metric\"] == metric_name]\n",
                "        return _f(row[\"Value\"].values[0]) if len(row) else None\n",
                "\n",
                "    # â”€â”€ Recuperar mÃ©tricas desde JSON â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    _cal = _metrics_json.get(\"calibration\", {})\n",
                "    _custom = _metrics_json.get(\"custom_metrics\", {})\n",
                "    _keras = _metrics_json.get(\"keras_metrics\", {})\n",
                "    _T_opt = _f(_cal.get(\"T_opt\", _custom.get(\"T_opt\")))\n",
                "    _nll_val_min = None  # no persiste directamente\n",
                "    _ece_uncal = _f(_custom.get(\"ece_uncal\"))\n",
                "    _ece_cal = _f(_cal.get(\"ece_cal\", _custom.get(\"ece_cal\")))\n",
                "    _brier_uncal = {\n",
                "        \"brier\": _f(_custom.get(\"brier_uncal\")),\n",
                "        \"reliability\": None,\n",
                "        \"resolution\": None,\n",
                "        \"uncertainty\": None,\n",
                "    }\n",
                "    _brier_cal = {\n",
                "        \"brier\": _f(_custom.get(\"brier_cal\")),\n",
                "        \"reliability\": None,\n",
                "        \"resolution\": None,\n",
                "        \"uncertainty\": None,\n",
                "    }\n",
                "    _nll_uncal = _f(_custom.get(\"nll_uncal\"))\n",
                "    _nll_cal = _f(_custom.get(\"nll_cal\"))\n",
                "    _error_auroc = _f(_custom.get(\"error_auroc\"))\n",
                "    _particle_acc = _f(_custom.get(\"particle_accuracy_custom\"))\n",
                "    _roc_auc = _f(_perf_val(\"AUC-ROC\"))\n",
                "    _gh_metrics = {\n",
                "        \"q_factor\": _f(_perf_val(\"Q-factor\")),\n",
                "        \"efficiency_gamma\": _f(_perf_val(\"Gamma Efficiency\")),\n",
                "        \"contamination_hadron\": _f(_perf_val(\"Hadron Contamination\")),\n",
                "    }\n",
                "    _acc_90 = _f(_custom.get(\"acc_at_90pct_coverage\"))\n",
                "    _delta_acc = _f(_custom.get(\"delta_acc_rejection\"))\n",
                "\n",
                "    # â”€â”€ Metadata de dataset y modelo â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    _feat_info = _meta.get(\"features\", {})\n",
                "    _feat_names = _feat_info.get(\"feature_order\", [])\n",
                "    _max_seq_len = int(_feat_info.get(\"max_sequence_length\", 0))\n",
                "    _global_feat = _w5_sc.get(\"GLOBAL_FEATURE_NAMES\", [])\n",
                "    _split = _meta.get(\"train_val_test_split\", {})\n",
                "    _filters = _meta.get(\"filters\", {})\n",
                "    _energy_filter = _filters.get(\"energies_used\", [])\n",
                "    _angle_max = float(_filters.get(\"angle_max_deg\", 40))\n",
                "    _min_particles = int(_filters.get(\"min_total_particles\", 30))\n",
                "\n",
                "    # No recuperables desde disco sin re-cargar el modelo\n",
                "    _model_params = None  # model no estÃ¡ en RAM en modo frÃ­o\n",
                "    _batch_size = None\n",
                "    _epochs = None\n",
                "    _mc_t = None\n",
                "    _mc_batch = None\n",
                "    _seed = None\n",
                "    _baseline_scores = {\"particle\": _f(_custom.get(\"particle_accuracy_custom\"))}\n",
                "\n",
                "    # â”€â”€ W5 desde disco â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n",
                "    _shap_seq_sum = pd.read_csv(_files[\"w5_shap_seq\"])\n",
                "    _shap_glob_sum = pd.read_csv(_files[\"w5_shap_glob\"])\n",
                "    _phi_0 = _f(_w5_sc.get(\"phi_0\"))\n",
                "    _n_bg = int(_w5_sc.get(\"N_BG\", 200))\n",
                "    _n_sample = int(_w5_sc.get(\"N_SAMPLE\", 300))\n",
                "    _t_shap = int(_w5_sc.get(\"T_SHAP\", 10))\n",
                "    _shap_seed = int(_w5_sc.get(\"SHAP_SEED\", 42))\n",
                "\n",
                "    _add_df = pd.read_csv(_files[\"w5_add_df\"])\n",
                "    _add_error = _add_df[\"additivity_error\"].values\n",
                "\n",
                "    print(\"Reconstrucción desde disco completada\")\n",
                "    print(f\"   (model.count_params() no disponible — modelo no cargado en modo frío)\")\n",
                "\n",
                "# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•\n",
                "\n",
                "# A PARTIR DE AQUÍ: código idéntico para ambos modos\n",
                "# Todas las variables tienen prefijo _ y están normalizadas\n",
                "# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•\n",
                "\n",
                "_gm = np.asarray(_y_label_test) == 1\n",
                "_hm = np.asarray(_y_label_test) == 0\n",
                "_best_ep = int(np.argmin(_history[\"val_loss\"]))\n",
                "\n",
                "# Normalizar shap DataFrames: wide (event×feature) → long (feature×stats)\n",
                "_seq_feat_cols = [c for c in _shap_seq_sum.columns if c not in (\"event_idx\", \"y_true\")]\n",
                "_shap_seq_feat_df = (\n",
                "    pd.DataFrame(\n",
                "        {\n",
                "            \"feature\": _seq_feat_cols,\n",
                "            \"mean_abs_shap\": [\n",
                "                float(_shap_seq_sum[c].abs().mean()) for c in _seq_feat_cols\n",
                "            ],\n",
                "            \"std_abs_shap\": [\n",
                "                float(_shap_seq_sum[c].abs().std()) for c in _seq_feat_cols\n",
                "            ],\n",
                "            \"mean_signed_shap\": [\n",
                "                float(_shap_seq_sum[c].mean()) for c in _seq_feat_cols\n",
                "            ],\n",
                "        }\n",
                "    )\n",
                "    .sort_values(\"mean_abs_shap\", ascending=False)\n",
                "    .reset_index(drop=True)\n",
                ")\n",
                "\n",
                "_glob_feat_cols = [\n",
                "    c for c in _shap_glob_sum.columns if c not in (\"event_idx\", \"y_true\")\n",
                "]\n",
                "_shap_glob_feat_df = (\n",
                "    pd.DataFrame(\n",
                "        {\n",
                "            \"feature\": _glob_feat_cols,\n",
                "            \"mean_abs_shap\": [\n",
                "                float(_shap_glob_sum[c].abs().mean()) for c in _glob_feat_cols\n",
                "            ],\n",
                "            \"std_abs_shap\": [\n",
                "                float(_shap_glob_sum[c].abs().std()) for c in _glob_feat_cols\n",
                "            ],\n",
                "            \"mean_signed\": [float(_shap_glob_sum[c].mean()) for c in _glob_feat_cols],\n",
                "        }\n",
                "    )\n",
                "    .sort_values(\"mean_abs_shap\", ascending=False)\n",
                "    .reset_index(drop=True)\n",
                ")\n",
                "\n",
                "\n",
                "# 1. DATASET\n",
                "dataset_section = {\n",
                "    \"total_events_balanced\": int(sum(_split.values()))\n",
                "    if not _kernel_hot\n",
                "    else int(len(_X_train) + len(_X_val) + len(_X_test)),\n",
                "    \"train_size\": _split.get(\"train\") if not _kernel_hot else int(len(_X_train)),\n",
                "    \"val_size\": _split.get(\"val\") if not _kernel_hot else int(len(_X_val)),\n",
                "    \"test_size\": _split.get(\"test\") if not _kernel_hot else int(len(_X_test)),\n",
                "    \"split_ratios\": \"70 / 15 / 15\",\n",
                "    \"split_strategy\": \"stratified by (angle Ã— label), seed=42\",\n",
                "    \"energy_bins_GeV\": _energy_filter,\n",
                "    \"angle_max_deg\": _angle_max,\n",
                "    \"min_total_particles\": _min_particles,\n",
                "    \"class_balance\": \"50/50 gamma/hadron (balanced sampling)\",\n",
                "    \"sequence_features\": _feat_names,\n",
                "    \"n_sequence_features\": len(_feat_names),\n",
                "    \"global_features\": _global_feat,\n",
                "    \"n_global_features\": len(_global_feat),\n",
                "    \"max_sequence_length\": _max_seq_len,\n",
                "    \"padding\": \"post-padding, mask_value=0.0 (Masking layer)\",\n",
                "    \"simulation_framework\": \"CORSIKA + EPOS (hadronic) + GEISHA (low-E)\",\n",
                "}\n",
                "\n",
                "# 2. ARQUITECTURA\n",
                "arch_section = {\n",
                "    \"model_name\": \"CONDOR_BayesianClassifier\",\n",
                "    \"total_params\": _model_params,\n",
                "    \"inputs\": {\n",
                "        \"sequence_input\": f\"(batch, {_max_seq_len}, {len(_feat_names)})\",\n",
                "        \"global_input\": f\"(batch, {len(_global_feat)})\",\n",
                "    },\n",
                "    \"cnn_branch\": {\n",
                "        \"n_conv_layers\": 3,\n",
                "        \"filters\": 128,\n",
                "        \"kernel_size\": 7,\n",
                "        \"padding\": \"same\",\n",
                "        \"activation\": \"elu\",\n",
                "        \"batch_norm\": True,\n",
                "        \"max_pool\": \"pool_size=2, padding=same\",\n",
                "        \"dense_layers\": [128, 256, 128],\n",
                "        \"dropout_type\": \"MCSpatialDropout1D\",\n",
                "        \"dropout_rate\": 0.30,\n",
                "    },\n",
                "    \"raw_branch\": {\"projection_dim\": 128, \"activation\": \"elu\"},\n",
                "    \"transformer_blocks\": {\n",
                "        \"n_blocks\": 2,\n",
                "        \"normalization\": \"Pre-LN\",\n",
                "        \"mha_heads\": 1,\n",
                "        \"mha_key_dim\": 32,\n",
                "        \"ffn_hidden_dim\": 128,\n",
                "        \"dropout_cnn_block\": \"MCSpatialDropout1D(0.10)\",\n",
                "        \"dropout_raw_block\": \"MCDropout(0.10)\",\n",
                "        \"pooling\": \"GlobalAveragePooling1D\",\n",
                "    },\n",
                "    \"fusion_head\": {\n",
                "        \"concatenation\": \"feat_cnn(128) || feat_raw(128) || global(5) â†’ 261-dim\",\n",
                "        \"dense_layers\": [128],\n",
                "        \"activation\": \"elu\",\n",
                "        \"dropout_head\": \"MCDropout(0.40) Ã— 2\",\n",
                "        \"output\": \"Dense(1, sigmoid, float32)\",\n",
                "    },\n",
                "    \"mcdropout_total_layers\": 7,\n",
                "}\n",
                "\n",
                "# 3. ENTRENAMIENTO\n",
                "training_section = {\n",
                "    \"optimizer\": \"Adam\",\n",
                "    \"learning_rate_initial\": 5e-4,\n",
                "    \"clipnorm\": 1.0,\n",
                "    \"loss_function\": \"binary_crossentropy\",\n",
                "    \"batch_size\": _batch_size,\n",
                "    \"max_epochs_configured\": _epochs,\n",
                "    \"actual_epochs_run\": len(_history[\"loss\"]),\n",
                "    \"best_epoch_1indexed\": _best_ep + 1,\n",
                "    \"best_val_loss\": _f(min(_history[\"val_loss\"])),\n",
                "    \"best_train_loss\": _f(_history[\"loss\"][_best_ep]),\n",
                "    \"best_val_f1\": _f(max(_history.get(\"val_f1_score\", [float(\"nan\")]))),\n",
                "    \"best_val_accuracy\": _f(max(_history.get(\"val_accuracy\", [float(\"nan\")]))),\n",
                "    \"callbacks\": {\n",
                "        \"EarlyStopping\": {\"monitor\": \"val_loss\", \"patience\": 15},\n",
                "        \"ReduceLROnPlateau\": {\"factor\": 0.5, \"patience\": 7, \"min_lr\": 1e-6},\n",
                "    },\n",
                "}\n",
                "\n",
                "# 4. BAYESIANO\n",
                "bayesian_section = {\n",
                "    \"framework\": \"Monte Carlo Dropout (Gal & Ghahramani, 2016)\",\n",
                "    \"MC_T_passes\": _mc_t,\n",
                "    \"temperature_scaling\": {\"T_opt\": _T_opt, \"nll_val_at_T_opt\": _nll_val_min},\n",
                "    \"sigma2_ep_stats\": {\n",
                "        \"gamma_mean\": _f(_sigma2_ep[_gm].mean()),\n",
                "        \"gamma_median\": _f(np.median(_sigma2_ep[_gm])),\n",
                "        \"gamma_std\": _f(_sigma2_ep[_gm].std()),\n",
                "        \"hadron_mean\": _f(_sigma2_ep[_hm].mean()),\n",
                "        \"hadron_median\": _f(np.median(_sigma2_ep[_hm])),\n",
                "        \"hadron_std\": _f(_sigma2_ep[_hm].std()),\n",
                "    },\n",
                "}\n",
                "\n",
                "# 5. RESULTADOS\n",
                "_cr_df = pd.DataFrame(\n",
                "    classification_report(\n",
                "        _y_label_test,\n",
                "        (_p_hat_cal >= 0.5).astype(int),\n",
                "        target_names=[\"Hadron\", \"Gamma\"],\n",
                "        output_dict=True,\n",
                "    )\n",
                ").T\n",
                "\n",
                "results_section = {\n",
                "    \"discrimination\": {\n",
                "        \"auc_roc\": _f(_roc_auc),\n",
                "        \"accuracy\": _f(_particle_acc),\n",
                "        \"f1_macro\": _f(_cr_df.at[\"macro avg\", \"f1-score\"]),\n",
                "        \"f1_gamma\": _f(_cr_df.at[\"Gamma\", \"f1-score\"]),\n",
                "        \"f1_hadron\": _f(_cr_df.at[\"Hadron\", \"f1-score\"]),\n",
                "        \"precision_gamma\": _f(_cr_df.at[\"Gamma\", \"precision\"]),\n",
                "        \"recall_gamma\": _f(_cr_df.at[\"Gamma\", \"recall\"]),\n",
                "        \"precision_hadron\": _f(_cr_df.at[\"Hadron\", \"precision\"]),\n",
                "        \"recall_hadron\": _f(_cr_df.at[\"Hadron\", \"recall\"]),\n",
                "        \"q_factor\": _f(_gh_metrics[\"q_factor\"]),\n",
                "        \"gamma_efficiency\": _f(_gh_metrics[\"efficiency_gamma\"]),\n",
                "        \"hadron_contamination\": _f(_gh_metrics[\"contamination_hadron\"]),\n",
                "    },\n",
                "    \"calibration\": {\n",
                "        \"ece_uncalibrated\": _f(_ece_uncal),\n",
                "        \"ece_calibrated\": _f(_ece_cal),\n",
                "        \"ece_improvement_pct\": _f((_ece_uncal - _ece_cal) / _ece_uncal * 100)\n",
                "        if _ece_uncal\n",
                "        else None,\n",
                "        \"brier_uncalibrated\": _f(_brier_uncal[\"brier\"]),\n",
                "        \"brier_calibrated\": _f(_brier_cal[\"brier\"]),\n",
                "        \"brier_reliability\": _brier_cal.get(\"reliability\"),\n",
                "        \"brier_resolution\": _brier_cal.get(\"resolution\"),\n",
                "        \"nll_uncalibrated\": _f(_nll_uncal),\n",
                "        \"nll_calibrated\": _f(_nll_cal),\n",
                "        \"nll_improvement_pct\": _f((_nll_uncal - _nll_cal) / _nll_uncal * 100)\n",
                "        if _nll_uncal\n",
                "        else None,\n",
                "    },\n",
                "    \"bayesian_validity\": {\n",
                "        \"error_auroc\": _f(_error_auroc),\n",
                "        \"acc_at_90pct_coverage\": _f(_acc_90),\n",
                "        \"delta_acc_rejection\": _f(_delta_acc),\n",
                "    },\n",
                "    \"per_energy_bin\": {\n",
                "        energy: {\n",
                "            \"n_test_samples\": int((_pred_summary[\"energy_level_true\"] == energy).sum()),\n",
                "            \"auc\": _f(\n",
                "                roc_auc_score(\n",
                "                    _pred_summary.loc[\n",
                "                        _pred_summary[\"energy_level_true\"] == energy, \"particle_true\"\n",
                "                    ],\n",
                "                    _pred_summary.loc[\n",
                "                        _pred_summary[\"energy_level_true\"] == energy, \"p_hat_cal\"\n",
                "                    ],\n",
                "                )\n",
                "            )\n",
                "            if (_pred_summary[\"energy_level_true\"] == energy).sum() > 10\n",
                "            else None,\n",
                "        }\n",
                "        for energy in [\"3E2\", \"5E2\", \"8E2\"]\n",
                "    },\n",
                "}\n",
                "\n",
                "# 6. XAI\n",
                "_top3_abl = _top_n_records(\n",
                "    _ablation[_ablation[\"task\"] == \"particle\"],\n",
                "    \"importance\",\n",
                "    n=3,\n",
                "    str_cols=(\"feature\", \"strategy\"),\n",
                ")\n",
                "_top3_pfi_ = _top_n_records(\n",
                "    _pfi[_pfi[\"task\"] == \"particle\"],\n",
                "    \"importance_delta\",\n",
                "    n=3,\n",
                "    str_cols=(\"feature\", \"task\", \"metric_name\"),\n",
                ")\n",
                "_top3_shap_s = _top_n_records(\n",
                "    _shap_seq_feat_df, \"mean_abs_shap\", n=3, str_cols=(\"feature\",)\n",
                ")\n",
                "_top3_shap_g = _top_n_records(\n",
                "    _shap_glob_feat_df, \"mean_abs_shap\", n=3, str_cols=(\"feature\",)\n",
                ")\n",
                "\n",
                "_ab_f = {str(r[\"feature\"]) for r in _top3_abl}\n",
                "_pfi_f = {str(r[\"feature\"]).replace(\"sequence::\", \"\") for r in _top3_pfi_}\n",
                "_sh_f = {str(r[\"feature\"]) for r in _top3_shap_s}\n",
                "\n",
                "xai_section = {\n",
                "    \"ablation\": {\n",
                "        \"strategy\": _ablation_strat,\n",
                "        \"MC_T_per_eval\": 30,\n",
                "        \"baseline_accuracy\": _f(_baseline_scores.get(\"particle\")),\n",
                "        \"top3_features\": _top3_abl,\n",
                "        \"all_features_ranked\": _ablation[_ablation[\"task\"] == \"particle\"][\n",
                "            [\"feature\", \"importance\", \"relative_importance\"]\n",
                "        ].to_dict(\"records\"),\n",
                "    },\n",
                "    \"pfi\": {\n",
                "        \"n_repeats\": 15,\n",
                "        \"MC_T_per_repeat\": 1,\n",
                "        \"metric\": \"accuracy\",\n",
                "        \"top3_features\": _top3_pfi_,\n",
                "        \"all_features_ranked\": _pfi[_pfi[\"task\"] == \"particle\"][\n",
                "            [\"feature\", \"importance_delta\", \"permuted_mean\", \"permuted_std\"]\n",
                "        ].to_dict(\"records\"),\n",
                "    },\n",
                "    \"shap_sequence\": {\n",
                "        \"explainer\": \"shap.GradientExplainer\",\n",
                "        \"background_n\": _n_bg,\n",
                "        \"explanation_n\": _n_sample,\n",
                "        \"MC_runs_averaged\": _t_shap,\n",
                "        \"top3_features\": _top3_shap_s,\n",
                "        \"all_features_ranked\": _shap_seq_feat_df[\n",
                "            [\"feature\", \"mean_abs_shap\", \"std_abs_shap\", \"mean_signed_shap\"]\n",
                "        ].to_dict(\"records\"),\n",
                "    },\n",
                "    \"shap_global\": {\n",
                "        \"top3_features\": _top3_shap_g,\n",
                "        \"all_features_ranked\": _shap_glob_feat_df[\n",
                "            [\"feature\", \"mean_abs_shap\", \"std_abs_shap\", \"mean_signed\"]\n",
                "        ].to_dict(\"records\"),\n",
                "    },\n",
                "    \"shap_additivity\": {\n",
                "        \"phi_0_baseline\": _phi_0,\n",
                "        \"mean_error\": _f(_add_error.mean()),\n",
                "        \"max_error\": _f(_add_error.max()),\n",
                "        \"std_error\": _f(_add_error.std()),\n",
                "        \"n_violations\": int((_add_error > 0.05).sum()),\n",
                "        \"violation_pct\": _f((_add_error > 0.05).sum() / len(_add_error) * 100),\n",
                "    },\n",
                "    \"cross_method\": {\n",
                "        \"methods\": [\"Ablation (W8)\", \"PFI (W8)\", \"SHAP (W5)\"],\n",
                "        \"consensus_all3\": list(_ab_f & _pfi_f & _sh_f),\n",
                "        \"consensus_2of3\": list(\n",
                "            set(list(_ab_f & _pfi_f) + list(_ab_f & _sh_f) + list(_pfi_f & _sh_f))\n",
                "        ),\n",
                "    },\n",
                "}\n",
                "\n",
                "# 7. FIGURAS\n",
                "figures_section = {\n",
                "    \"W3_W4\": {\n",
                "        \"training_curves\": \"pipeline_artifacts/diagnostics/training_curves_artifacts.png\",\n",
                "        \"calibration_reliability\": \"pipeline_artifacts/diagnostics/calibration_reliability_diagram.png\",\n",
                "        \"bayesian_coverage\": \"pipeline_artifacts/diagnostics/bayesian_coverage_efficiency.png\",\n",
                "        \"confusion_by_energy\": \"pipeline_artifacts/diagnostics/particle_confusion_by_energy.png\",\n",
                "    },\n",
                "    \"W8\": {\n",
                "        \"ablation\": \"pipeline_artifacts/diagnostics/feature_ablation_results.png\",\n",
                "        \"pfi\": \"pipeline_artifacts/diagnostics/permutation_importance_all_tasks.png\",\n",
                "    },\n",
                "    \"W5\": {\n",
                "        \"shap_sequence\": \"pipeline_artifacts/diagnostics/shap_sequence_summary.png\",\n",
                "        \"shap_global\": \"pipeline_artifacts/diagnostics/shap_global_features.png\",\n",
                "    },\n",
                "}\n",
                "\n",
                "# 8. SERIALIZACIÓN FINAL PARA PAPER\n",
                "paper_data = {\n",
                "    \"_meta\": {\n",
                "        \"generated_at\": pd.Timestamp.now().isoformat(),\n",
                "        \"kernel_mode\": \"hot\" if _kernel_hot else \"cold\",\n",
                "        \"completed_weeks\": [\"W1\", \"W2\", \"W3\", \"W4\", \"W5\", \"W8\"],\n",
                "        \"pending_weeks\": [\"W6\", \"W7\", \"W9\"],\n",
                "        \"w5_var_mapping\": W5_VARS,\n",
                "        \"extraction_version\": \"v2.3\",\n",
                "    },\n",
                "    \"dataset\": dataset_section,\n",
                "    \"architecture\": arch_section,\n",
                "    \"training\": training_section,\n",
                "    \"bayesian\": bayesian_section,\n",
                "    \"results\": results_section,\n",
                "    \"xai\": xai_section,\n",
                "    \"figures\": figures_section,\n",
                "}\n",
                "\n",
                "\n",
                "def _serialize(obj):\n",
                "    if isinstance(obj, dict):\n",
                "        return {k: _serialize(v) for k, v in obj.items()}\n",
                "    if isinstance(obj, list):\n",
                "        return [_serialize(v) for v in obj]\n",
                "    if isinstance(obj, np.integer):\n",
                "        return int(obj)\n",
                "    if isinstance(obj, np.floating):\n",
                "        return None if (np.isnan(obj) or np.isinf(obj)) else float(obj)\n",
                "    if isinstance(obj, np.ndarray):\n",
                "        return obj.tolist()\n",
                "    if isinstance(obj, float) and (np.isnan(obj) or np.isinf(obj)):\n",
                "        return None\n",
                "    return obj\n",
                "\n",
                "\n",
                "output_path = Path(\"paper_ready_data.json\")\n",
                "with output_path.open(\"w\", encoding=\"utf-8\") as fh:\n",
                "    json.dump(_serialize(paper_data), fh, indent=2, ensure_ascii=False)\n",
                "\n",
                "_kb = output_path.stat().st_size / 1024\n",
                "print(\n",
                "    f\"\\nâœ…  paper_ready_data.json ({_kb:.1f} KB) â€” modo {'ðŸ”¥ hot' if _kernel_hot else 'â„ï¸  cold'}\"\n",
                ")\n",
                "print(f\"  AUC-ROC:        {results_section['discrimination']['auc_roc']}\")\n",
                "print(f\"  ECE (cal):      {results_section['calibration']['ece_calibrated']}\")\n",
                "print(f\"  T*:             {bayesian_section['temperature_scaling']['T_opt']}\")\n",
                "print(f\"  Error AUROC:    {results_section['bayesian_validity']['error_auroc']}\")\n",
                "print(f\"  Consenso 3/3:   {xai_section['cross_method']['consensus_all3']}\")\n"
            ]
        }
    ],
