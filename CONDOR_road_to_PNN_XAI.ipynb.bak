      "2026-06-08 02:05:20,350  DEBUG     findfont: score(FontEntry(fname='C:\\\\Windows\\\\Fonts\\\\BOD_CI.TTF', name='Bodoni MT', style='italic', variant='normal', weight=400, stretch='condensed', size='scalable')) = 11.25\n",
      "2026-06-08 02:05:20,350  DEBUG     findfont: score(FontEntry(fname='C:\\\\Windows\\\\Fonts\\\\Candarali.ttf', name='Candara', style='italic', variant='normal', weight=400, stretch='normal', size='scalable')) = 11.05\n",
      "2026-06-08 02:05:20,360  DEBUG     findfont: score(FontEntry(fname='C:\\\\Windows\\\\Fonts\\\\SegUIVar.ttf', name='Segoe UI Variable', style='normal', variant='normal', weight=400, stretch='normal', size='scalable')) = 10.05\n",
      "2026-06-08 02:05:20,361  DEBUG     findfont: score(FontEntry(fname='C:\\\\Windows\\\\Fonts\\\\sylfaen.ttf', name='Sylfaen', style='normal', variant='normal', weight=400, stretch='normal', size='scalable')) = 10.05\n",
      "2026-06-08 02:05:20,361  DEBUG     findfont: score(FontEntry(fname='C:\\\\Windows\\\\Fonts\\\\GILBI___.TTF', name='Gill Sans MT', style='italic', variant='normal', weight=700, stretch='normal', size='scalable')) = 11.335\n",
      "2026-06-08 02:05:20,361  DEBUG     findfont: Matching sans\\-serif:style=normal:variant=normal:weight=normal:stretch=normal:size=8.0 to Arial ('C:\\\\Windows\\\\Fonts\\\\arial.ttf') with score of 0.050000.\n",
