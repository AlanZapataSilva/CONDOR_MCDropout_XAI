            "source": [
                "### Spatial Attention (Detector Map)\n",
                "\n",
                "- Attention aggregated per detector_id using geometry.\n",
                "- Radial trends, quadrant analysis.\n"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "398d6aa4",
            "metadata": {},
            "outputs": [
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "2026-06-15 08:05:38,656  INFO      \n",
                        "[1] ANÃLISIS ESPACIAL: Mapeo de importancia por detector\n",
                        "2026-06-15 08:05:39,268  INFO      \n",
                        "Particle Classification:\n",
                        "  Detectores analizados: 120\n",
                        "  AtenciÃ³n promedio: 0.012910 Â± 0.013769\n",
                        "2026-06-15 08:05:39,307  DEBUG     locator: <matplotlib.ticker.AutoLocator object at 0x00000187FEFB1600>\n"
                    ]
                },
                {
                    "data": {
                        "image/png": "",
