                "### Attention Maps\n",
                "\n",
                "- Auxiliary model to extract attention (class/angle/energy heads).\n",
                "- Average attention heatmaps with padding masks.\n"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "b8962af4",
            "metadata": {},
            "outputs": [
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "2026-06-15 08:04:58,598  INFO      Creating auxiliary model (CNN + RAW) to extract attention scores...\n",
                        "2026-06-15 08:04:58,993  INFO      Auxiliary attention model (CNN+RAW) created successfully.\n"
                    ]
                }
            ],
            "source": [
                "# ===========================\n",
                "# Auxiliary Model for Attention Scores Extraction\n",
                "# ===========================\n",
                "logging.info(\"Creating auxiliary model (CNN + RAW) to extract attention scores...\")\n",
                "\n",
                "# MHA layers (CNN)\n",
                "mha_class_cnn = model.get_layer(\"mha_class_cnn\")\n",
                "\n",
                "# MHA layers (RAW)\n",
                "mha_class_raw = model.get_layer(\"mha_class_raw\")\n",
                "\n",
                "# Normalized inputs (CNN)\n",
                "pre_mha_class_cnn = model.get_layer(\"pre_mha_norm_class_cnn\").output\n",
                "\n",
                "# Normalized inputs (RAW)\n",
                "pre_mha_class_raw = model.get_layer(\"pre_mha_norm_class_raw\").output\n",
                "\n",
                "# Calls with return_attention_scores=True\n",
                "_, attn_class_cnn = mha_class_cnn(\n",
                "    pre_mha_class_cnn, pre_mha_class_cnn, return_attention_scores=True\n",
                ")\n",
                "_, attn_class_raw = mha_class_raw(\n",
                "    pre_mha_class_raw, pre_mha_class_raw, return_attention_scores=True\n",
                ")\n",
                "\n",
                "attention_model = Model(\n",
                "    inputs=model.inputs,\n",
                "    outputs=[\n",
                "        attn_class_cnn,\n",
                "        attn_class_raw,\n",
                "    ],\n",
                "    name=\"CONDOR_AttentionExtractor\",\n",
                ")\n",
                "\n",
                "logging.info(\"Auxiliary attention model (CNN+RAW) created successfully.\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "edfebfbd",
            "metadata": {},
            "outputs": [
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "2026-06-15 08:04:59,086  INFO      Extracting attention scores from 200 samples...\n"
                    ]
                },
                {
                    "name": "stdout",
                    "output_type": "stream",
                    "text": [
                        "50/50 [==============================] - 21s 412ms/step\n"
                    ]
                },
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "2026-06-15 08:05:21,085  INFO      Shapes CNN attention score (class): (200, 1, 233, 233)\n",
                        "2026-06-15 08:05:21,085  INFO      Shapes RAW attention score (class): (200, 1, 466, 466)\n",
                        "2026-06-15 08:05:21,654  DEBUG     locator: <matplotlib.ticker.AutoLocator object at 0x000001869A46F8B0>\n",
                        "2026-06-15 08:05:21,921  DEBUG     locator: <matplotlib.ticker.AutoLocator object at 0x000001869A7A9420>\n"
                    ]
                },
