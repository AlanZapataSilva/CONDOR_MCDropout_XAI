            "source": [
                "### Correlation: Attention vs Physical Features\n",
                "\n",
                "- Spearman correlations with particle_count, total_energy, temporal position, radial distance.\n"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "482b5def",
            "metadata": {},
            "outputs": [
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "2026-06-15 08:05:41,842  INFO      \n",
                        "[3] CORRELACIÃ“N ENTRE ATENCIÃ“N Y FEATURES FÃSICAS\n"
                    ]
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 1400x500 with 2 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
