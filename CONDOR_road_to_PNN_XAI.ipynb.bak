                "# Execute ablation\n",
                "ablation_results, baseline_scores = run_ablation_study(\n",
                "    model=model,\n",
                "    x_seq=X_test,\n",
                "    x_global=Xg_test,\n",
                "    feature_names=FEATURE_NAMES,\n",
                "    y_true_dict=y_true_dict,\n",
                "    strategy=ABLATION_STRATEGY_USED,\n",
                "    batch_size=64,\n",
                "    verbose=True,\n",
